{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXUS-VPN",
  "version": "1.0.0",
  "identifier": "com.nexus.vpn",
  "build": {
    "frontendDist": "../assets",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NEXUS-VPN",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "shell": {
      "scope": [
        {
          "name": "execute",
          "cmd": "powershell",
          "args": true
        }
      ]
    }
  }
}
